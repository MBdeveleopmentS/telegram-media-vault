# ---------------------------------------------------------------------------
# Telegram Media Vault — environment template. Copy to .env (never commit .env).
# Generate all random secrets with:  python3 scripts/gen_env_secrets.py >> .env
# ---------------------------------------------------------------------------

ENVIRONMENT=development          # development | production
LOG_LEVEL=INFO                   # DEBUG is refused in production

# --- Telegram (developer-owned application credentials; end users never see these)
BOT_TOKEN=                       # from @BotFather
TELEGRAM_API_ID=                 # from https://my.telegram.org -> API development tools
TELEGRAM_API_HASH=

# --- Public URL of the auth page (must be https:// in production)
PUBLIC_BASE_URL=http://localhost:8085
AUTHWEB_HOST_PORT=8085
TRUST_PROXY_HEADERS=false        # true only behind your own reverse proxy

# --- Bot update delivery
BOT_MODE=polling                 # polling | webhook (webhook needs WEBHOOK_SECRET + https)
SUPPORT_CONTACT=@your_support_handle

# --- Plans (server-side; change here only)
FREE_MAX_CHATS=3
FREE_MAX_FILE_MIB=5
PREMIUM_MAX_CHATS=10
PREMIUM_MAX_FILE_MIB=15
PREMIUM_PRICE_STARS=150
PREMIUM_PERIOD_DAYS=90

WORKER_CONCURRENCY=2

# --- Secrets: generated by scripts/gen_env_secrets.py (appended below)
# APP_SECRET_KEY=
# SESSION_ENCRYPTION_KEYS=k1:...
# SESSION_ENCRYPTION_ACTIVE_KEY_ID=k1
# WEBHOOK_SECRET=
# REDIS_PASSWORD=
# POSTGRES_OWNER_PASSWORD=
# VAULT_BOT_DB_PASSWORD=
# VAULT_AUTHWEB_DB_PASSWORD=
# VAULT_ENGINE_DB_PASSWORD=
# VAULT_SCHEDULER_DB_PASSWORD=
